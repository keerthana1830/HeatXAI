# Database Configuration (Local MySQL)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=thermacity

# Redis Configuration (Local Redis or mock)
# If local Redis is not installed, the platform fallback runs Celery synchronously.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Security Configuration
SECRET_KEY=super_secret_jwt_signing_key_change_me_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Google Earth Engine Integration (Phase 2+)
# Place JSON credentials key in backend/gee-private-key.json or paste base64 encoded JSON here:
GEE_SERVICE_ACCOUNT_EMAIL=
GEE_SERVICE_ACCOUNT_KEY=
